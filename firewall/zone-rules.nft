# Zone direction chains. Names are FROM-TO.
# Rule order: explicit allows, then invalid drop log, then terminal action.

chain CONTAINERS-LOCAL {
  meta l4proto { tcp, udp } th dport { 53, 853 } counter accept comment "allow DNS to local"
  udp sport { 67, 68 } udp dport { 67, 68 } counter accept comment "allow DHCP to local"
  udp dport 123 counter accept comment "allow NTP to local"
  ct state invalid counter log prefix "[CONTAINERS-LOCAL-invalid-D] " drop
  counter log prefix "[CONTAINERS-LOCAL-default-D] " drop
}

chain CONTAINERS-SERVERS {
  counter accept comment "default-action accept"
}

chain CONTAINERS-WAN {
  counter accept comment "default-action accept"
}

chain CONTAINERS-TRANSIT {
  tcp dport { 6443, 50000 } ip daddr @k8s_nodes counter accept comment "allow haproxy to access talos"
  meta l4proto { tcp, udp } th dport 53 ip daddr 10.45.0.55 counter accept comment "allow dnsdist to access in cluster bind"
  ct state invalid counter log prefix "[CONTAINERS-TRANSIT-invalid-D] " drop
  counter log prefix "[CONTAINERS-TRANSIT-default-D] " drop
}

chain GUEST-WAN {
  counter accept comment "default-action accept"
}

chain GUEST-LOCAL {
  udp sport { 67, 68 } udp dport { 67, 68 } counter accept comment "allow DHCP to local"
  ct state invalid counter log prefix "[GUEST-LOCAL-invalid-D] " drop
  counter log prefix "[GUEST-LOCAL-default-D] " drop
}

chain GUEST-CONTAINERS {
  meta l4proto { tcp, udp } th dport { 53, 853 } counter accept comment "allow DNS to containers"
  ct state invalid counter log prefix "[GUEST-CONTAINERS-invalid-D] " drop
  counter log prefix "[GUEST-CONTAINERS-default-D] " drop
}

chain GUEST-TRANSIT {
  meta l4proto { tcp, udp } th dport 53 ip daddr 172.53.53.53 counter accept comment "allow DNS"
  ct state invalid counter log prefix "[GUEST-TRANSIT-invalid-D] " drop
  counter log prefix "[GUEST-TRANSIT-default-D] " drop
}

chain IOT-WAN {
  counter accept comment "default-action accept"
}

chain IOT-LOCAL {
  udp sport { 67, 68 } udp dport { 67, 68 } counter accept comment "allow DHCP to local"
  udp dport 123 counter accept comment "allow NTP to local"
  ip protocol igmp counter accept comment "allow IGMP"
  udp dport 5353 ip daddr 224.0.0.251 counter accept comment "allow mDNS"
  ct state invalid counter log prefix "[IOT-LOCAL-invalid-D] " drop
  counter log prefix "[IOT-LOCAL-default-D] " drop
}

chain IOT-SERVERS {
  ip protocol icmp counter accept comment "allow ICMP"
  tcp dport 32400 ip saddr @plex_clients ip daddr @k8s_plex counter accept comment "allow plex clients to plex"
  meta l4proto { tcp, udp } ip saddr @plex_clients ip daddr @k8s_jellyfin counter accept comment "allow plex clients to jellyfin"
  tcp dport @k8s_ingress_ports ip saddr @k8s_ingress_clients ip daddr @k8s_ingress counter accept comment "allow k8s ingress"
  ct state invalid counter log prefix "[IOT-SERVERS-invalid-D] " drop
  counter log prefix "[IOT-SERVERS-default-D] " drop
}

chain IOT-CONTAINERS {
  meta l4proto { tcp, udp } th dport { 53, 853 } counter accept comment "allow DNS to containers"
  counter accept comment "default-action accept"
}

chain IOT-TRUSTED {
  ip protocol icmp counter accept comment "allow ICMP"
  meta l4proto { tcp, udp } th dport @apple_services_ports ip saddr @airplay_targets ip daddr @airplay_sources counter accept comment "allow Apple services"
  ct state invalid counter log prefix "[IOT-TRUSTED-invalid-D] " drop
  counter log prefix "[IOT-TRUSTED-default-D] " drop
