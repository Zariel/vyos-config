# Ignore everything
/*

# Track certain files and directories
!.gitignore
!*.sh
!*.script
!/spamhaus-drop.py
!/tests/
/tests/*
!/tests/test_spamhaus_drop.py

!/patches/
/patches/*
!/patches/*.patch

!/commit
/commit/*
!/commit/pre-hooks.d
/commit/pre-hooks.d/*
!/commit/pre-hooks.d/**.sh

!/commit/post-hooks.d
/commit/post-hooks.d/*
!/commit/post-hooks.d/99-cake-ingress
!/commit/post-hooks.d/95-spamhaus-drop
