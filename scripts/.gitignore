# Ignore everything
/*

# Track certain files and directories
!.gitignore
!*.sh
!*.script

!/patches/
/patches/*
!/patches/*.patch

!/commit
/commit/*
!/commit/pre-hooks.d
/commit/pre-hooks.d/*
!/commit/pre-hooks.d/**.sh

!/commit/post-hooks.d
/commit/post-hooks.d/*
!/commit/post-hooks.d/99-cake-ingress
