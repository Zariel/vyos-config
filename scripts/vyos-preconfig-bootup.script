#!/bin/sh
# This script is executed before VyOS loads its configuration.

# Preserve the existing bind container directory setup.
mkdir -p /tmp/bind/cache
chown -R 100 /tmp/bind/cache

# VyOS 1.4 incorrectly requires both address families on every mDNS interface
# in "both" mode. Avahi supports mixed links, including IPv6-only Matter VLANs.
# Reapply the small validator fix before startup configuration is validated.
mdns_script=/usr/libexec/vyos/conf_mode/service_mdns_repeater.py
mdns_patch=/config/scripts/patches/mdns-mixed-address-families.patch
if ! patch --dry-run -R "$mdns_script" "$mdns_patch" >/dev/null 2>&1; then
    patch -N "$mdns_script" "$mdns_patch"
    # configd starts before this hook and preloads configuration modules.
    systemctl restart vyos-configd.service
fi
